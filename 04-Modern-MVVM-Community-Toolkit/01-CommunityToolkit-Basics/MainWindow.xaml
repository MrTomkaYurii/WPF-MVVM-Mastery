<Window x:Class="CommunityToolkitBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CommunityToolkitBasics.ViewModels"
        Title="MVVM Community Toolkit Source Generators (.NET 10)" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:CounterViewModel/>
    </Window.DataContext>
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CommunityToolkit.Mvvm v8.4+" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Automatic [ObservableProperty] and [RelayCommand] Source Generation" Foreground="#64748B" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="User: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10,0,0,0" Padding="4"/>
            </StackPanel>

            <TextBlock Text="{Binding Count}" FontSize="48" FontWeight="Black" HorizontalAlignment="Center" Margin="0,10" Foreground="#2563EB"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#475569"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="➕ Increment" Command="{Binding IncrementCommand}" Width="120" Height="40" Margin="5"/>
                <Button Content="➖ Decrement" Command="{Binding DecrementCommand}" Width="120" Height="40" Margin="5"/>
                <Button Content="🔄 Reset" Command="{Binding ResetCommand}" Width="120" Height="40" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
