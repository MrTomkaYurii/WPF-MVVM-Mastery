<Window x:Class="ValidationShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ValidationShowcase.ViewModels"
        Title="ObservableValidator &amp; INotifyDataErrorInfo (.NET 10)" Height="450" Width="550"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:RegistrationViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <ControlTemplate x:Key="ValidationTemplate">
            <StackPanel>
                <AdornedElementPlaceholder/>
                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Crimson" FontSize="11" Margin="2,2,0,0"/>
            </StackPanel>
        </ControlTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationTemplate}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Form Validation with ObservableValidator" FontSize="18" FontWeight="Bold"/>

            <TextBlock Text="Username:"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <TextBlock Text="Email:"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <TextBlock Text="Age (18 - 100):"/>
            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <Button Content="Submit Registration" Command="{Binding RegisterCommand}" Height="40" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
