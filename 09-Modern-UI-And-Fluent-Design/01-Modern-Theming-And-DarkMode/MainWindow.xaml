<Window x:Class="ThemingShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runtime Theme Switching (.NET 10)" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="20">
        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="25" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Dynamic Light / Dark Theme Switching" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppForeground}"/>
                <TextBlock Text="Themes are swapped in Application.Current.Resources.MergedDictionaries at runtime."
                           Foreground="{DynamicResource AppForeground}" Opacity="0.8" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="☀️ Light Mode" Click="SetLight_Click" Width="140" Height="40" Margin="0,0,10,0"/>
                    <Button Content="🌙 Dark Mode" Click="SetDark_Click" Width="140" Height="40"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
