<Window x:Class="DispatcherShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dispatcher &amp; IProgress Multithreading (.NET 10)" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Background Thread to UI Dispatcher Updates" FontSize="18" FontWeight="Bold"/>
            <ProgressBar x:Name="ProgBar" Maximum="100" Height="25"/>
            <TextBlock x:Name="StatusTxt" Text="Ready" FontSize="15" FontWeight="SemiBold"/>
            <Button x:Name="StartBtn" Content="Start Heavy Computation Task" Click="StartBtn_Click" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
