<Window x:Class="ResourcesShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResourceDictionary &amp; Merged Dictionaries (.NET 10)" Height="350" Width="550"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundColor}">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Merged ResourceDictionaries Demo" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Styles and Colors structured across external modular dictionaries." Margin="0,0,0,20"/>
            <Button Content="Primary Styled Button" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Width="200" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
