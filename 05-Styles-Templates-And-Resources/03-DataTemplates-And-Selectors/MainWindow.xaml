<Window x:Class="DataTemplatesShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DataTemplatesShowcase.Models"
        xmlns:s="clr-namespace:DataTemplatesShowcase.Selectors"
        Title="DataTemplates &amp; Selectors (.NET 10)" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="TextPostTemplate" DataType="{x:Type m:TextPost}">
            <Border Background="#F1F5F9" Padding="10" Margin="0,4" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{Binding Author}" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="{Binding Message}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlertPostTemplate" DataType="{x:Type m:AlertPost}">
            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" Padding="10" Margin="0,4" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{Binding AlertLevel, StringFormat='⚠️ ALERT: {0}'}" FontWeight="Black" Foreground="#B91C1C"/>
                    <TextBlock Text="{Binding Details}" Foreground="#7F1D1D" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <s:FeedTemplateSelector x:Key="FeedSelector"
                               TextTemplate="{StaticResource TextPostTemplate}"
                               AlertTemplate="{StaticResource AlertPostTemplate}"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Polymorphic Feeds via DataTemplateSelector" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <ListBox Grid.Row="1" x:Name="FeedListBox" ItemTemplateSelector="{StaticResource FeedSelector}"/>
    </Grid>
</Window>
