<Window x:Class="ControlsShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ControlsShowcase.Controls"
        Title="UserControl with DependencyProperty (.NET 10)" Height="350" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Reusable RatingControl UserControl" FontSize="18" FontWeight="Bold"/>
            <c:RatingControl x:Name="Rating" Value="4"/>
            <TextBlock Text="{Binding ElementName=Rating, Path=Value, StringFormat='Selected Rating: {0} / 5'}" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
