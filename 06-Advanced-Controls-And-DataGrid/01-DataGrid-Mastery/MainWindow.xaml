<Window x:Class="DataGridMastery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataGrid Mastery with RowDetails (.NET 10)" Height="450" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order #" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="200"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="120"/>
                <DataGridCheckBoxColumn Header="Shipped" Binding="{Binding IsShipped}" Width="80"/>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="📦 Shipping Details:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ShippingAddress, StringFormat='Destination: {0}'}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</Window>
