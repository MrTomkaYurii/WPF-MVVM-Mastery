<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NavigationShowcase.ViewModels">

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <Border Background="#EFF6FF" CornerRadius="8" Padding="20">
            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <Border Background="#F3F4F6" CornerRadius="8" Padding="20">
            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="Bold" Foreground="#374151"/>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <Border Background="#ECFDF5" CornerRadius="8" Padding="20">
            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="Bold" Foreground="#065F46"/>
        </Border>
    </DataTemplate>
</ResourceDictionary>
