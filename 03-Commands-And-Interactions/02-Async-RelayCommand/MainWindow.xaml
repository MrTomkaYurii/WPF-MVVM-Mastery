<Window x:Class="AsyncRelayCommandShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AsyncRelayCommandShowcase.ViewModels"
        Title="AsyncRelayCommand with Cancellation (.NET 10)" Height="350" Width="550"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:DownloadViewModel/>
    </Window.DataContext>
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Async Command &amp; CancellationToken Pattern" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="25" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Start Async Task" Command="{Binding StartDownloadCommand}" Width="150" Height="38" Margin="0,0,10,0"/>
                <Button Content="Cancel Operation" Command="{Binding CancelCommand}" Width="150" Height="38"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
