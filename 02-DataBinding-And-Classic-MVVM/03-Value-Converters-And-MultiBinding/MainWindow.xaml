<Window x:Class="ValueConvertersShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ValueConvertersShowcase.Converters"
        xmlns:vm="clr-namespace:ValueConvertersShowcase.ViewModels"
        Title="Value Converters &amp; MultiBinding (.NET 10)" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BalanceToColorConverter x:Key="BalanceToColor"/>
        <conv:FullNameMultiConverter x:Key="FullNameConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="IValueConverter &amp; IMultiValueConverter Demo" FontSize="20" FontWeight="Bold"/>

            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="First Name:" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                <TextBlock Text="Last Name:" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                <TextBlock Text="Account Balance:" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox Text="{Binding AccountBalance, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                <TextBlock Text="VIP Member:" Grid.Row="3" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding IsVipMember}" Grid.Row="3" Grid.Column="1" Margin="0,5" Content="Show VIP Badge"/>
            </Grid>

            <Separator Margin="0,5"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Calculated Full Name (MultiBinding): " FontWeight="SemiBold"/>
                <TextBlock FontWeight="Bold">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FullNameConverter}">
                            <Binding Path="FirstName"/>
                            <Binding Path="LastName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Formatted Balance (StringFormat &amp; Color): " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AccountBalance, StringFormat='{}{0:C}'}" 
                           Foreground="{Binding AccountBalance, Converter={StaticResource BalanceToColor}}"
                           FontWeight="Bold"/>
            </StackPanel>

            <Border Background="#FEF08A" Padding="8" CornerRadius="4" 
                    Visibility="{Binding IsVipMember, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⭐ VIP Priority Account Customer ⭐" FontWeight="Bold" Foreground="#854D0E"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
