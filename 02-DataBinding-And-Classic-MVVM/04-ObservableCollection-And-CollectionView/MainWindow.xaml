<Window x:Class="CollectionViewShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CollectionViewShowcase.ViewModels"
        Title="ObservableCollection &amp; ICollectionView (.NET 10)" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:ProductCatalogViewModel/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ObservableCollection &amp; ICollectionView Live Filtering/Grouping" FontSize="18" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search / Filter: " VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Padding="4"/>
        </Grid>

        <ListView Grid.Row="2" ItemsSource="{Binding ProductsView}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#E2E8F0" Padding="6" Margin="0,2">
                                <TextBlock Text="{Binding Name, StringFormat='📂 Category: {0}'}" FontWeight="Bold" Foreground="#1E293B"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Product Name" DisplayMemberBinding="{Binding Name}" Width="250"/>
                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="120"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price, StringFormat='{}{0:C}'}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
