<Window x:Class="LayoutPanelsShowcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Layout Panels Showcase (.NET 10)" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl Margin="10">
            <!-- TAB 1: GRID -->
            <TabItem Header="1. Grid &amp; Sizing">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1E293B" Padding="10" CornerRadius="4" Margin="0,0,0,5">
                        <TextBlock Text="Grid: Star (*), Auto, Absolute pixels, and GridSplitter" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#3B82F6" Margin="2" Padding="5">
                        <TextBlock Text="Fixed 200px / Auto Row" Foreground="White"/>
                    </Border>
                    <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#94A3B8"/>
                    <Border Grid.Row="1" Grid.Column="2" Background="#10B981" Margin="2" Padding="5">
                        <TextBlock Text="Star (*) Column / 1* Row" Foreground="White"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="#6366F1" Margin="2" Padding="5">
                        <TextBlock Text="Fixed 200px / 2* Row" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Background="#F59E0B" Margin="2" Padding="5">
                        <TextBlock Text="Star (*) Column / 2* Row (Double Height)" Foreground="White"/>
                    </Border>

                    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#64748B" Margin="2" Padding="5">
                        <TextBlock Text="Fixed 50px Footer Row (Span 3 Columns)" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: STACK & WRAP -->
            <TabItem Header="2. StackPanel vs WrapPanel">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="StackPanel (Vertical by default)" Margin="5">
                        <StackPanel Margin="5">
                            <Button Content="Button 1" Margin="2" Padding="5"/>
                            <Button Content="Button 2" Margin="2" Padding="5"/>
                            <Button Content="Button 3" Margin="2" Padding="5"/>
                            <TextBlock Text="Items stretch to fill width unless specified." Margin="2,10" FontStyle="Italic"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="WrapPanel (Flows across boundaries)" Margin="5">
                        <WrapPanel Orientation="Horizontal" Margin="5">
                            <Button Content="Item #1" Width="80" Height="40" Margin="3"/>
                            <Button Content="Item #2" Width="100" Height="40" Margin="3"/>
                            <Button Content="Item #3" Width="90" Height="40" Margin="3"/>
                            <Button Content="Item #4" Width="120" Height="40" Margin="3"/>
                            <Button Content="Item #5" Width="70" Height="40" Margin="3"/>
                            <Button Content="Item #6" Width="110" Height="40" Margin="3"/>
                        </WrapPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: DOCK & UNIFORM GRID -->
            <TabItem Header="3. DockPanel &amp; UniformGrid">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="DockPanel (LastChildFill = True)" Margin="5">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="40" Background="#0284C7" Padding="5">
                                <TextBlock Text="Dock Top: Navigation / Header" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Height="30" Background="#334155" Padding="5">
                                <TextBlock Text="Dock Bottom: Status Bar" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Left" Width="100" Background="#0D9488" Padding="5">
                                <TextBlock Text="Dock Left" Foreground="White"/>
                            </Border>
                            <Border Background="#F1F5F9" Padding="10">
                                <TextBlock Text="Center Content (Fills Remaining Space)" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="UniformGrid (Equal Cells 2x2)" Margin="5">
                        <UniformGrid Rows="2" Columns="2">
                            <Border Background="#FCA5A5" Margin="5" Padding="10"><TextBlock Text="Card 1 (25%)"/></Border>
                            <Border Background="#FDE047" Margin="5" Padding="10"><TextBlock Text="Card 2 (25%)"/></Border>
                            <Border Background="#86EFAC" Margin="5" Padding="10"><TextBlock Text="Card 3 (25%)"/></Border>
                            <Border Background="#93C5FD" Margin="5" Padding="10"><TextBlock Text="Card 4 (25%)"/></Border>
                        </UniformGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 4: CANVAS -->
            <TabItem Header="4. Canvas (Absolute Coordinates)">
                <Canvas Margin="10" Background="#F8FAFC" ClipToBounds="True">
                    <Border Canvas.Left="50" Canvas.Top="40" Width="160" Height="100" Background="#EC4899" CornerRadius="8" Padding="10" Panel.ZIndex="1">
                        <TextBlock Text="Canvas.Left=50&#x0a;Canvas.Top=40&#x0a;ZIndex=1" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Canvas.Left="120" Canvas.Top="80" Width="160" Height="100" Background="#8B5CF6" CornerRadius="8" Padding="10" Panel.ZIndex="2">
                        <TextBlock Text="Canvas.Left=120&#x0a;Canvas.Top=80&#x0a;ZIndex=2 (On Top)" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Canvas.Left="50" Canvas.Top="220" Text="Canvas is ideal for custom graph editors, game boards, and overlay annotations." Foreground="#475569" FontStyle="Italic"/>
                </Canvas>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
